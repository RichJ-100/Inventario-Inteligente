{
    "name": "Apache 2.4 & MySQL 9.7 Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            // Extensiones útiles sugeridas para tu espacio de trabajo
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-mysql"
            ]
        }
    },
    // Redirección de puertos automática: 80 (Apache) y 3306 (MySQL)
    "forwardPorts": [80, 3306],
    "portsAttributes": {
        "80": {
            "label": "Web Server (Apache)",
            "onAutoForward": "openPreview"
        },
        "3306": {
            "label": "Database (MySQL)",
            "onAutoForward": "silent"
        }
    },
    // Asegura que los servicios se activen con privilegios si el contenedor no corre el CMD por defecto
    "postStartCommand": "sudo service apache2 start && sudo service mysql start",
    "remoteUser": "vscode"
}
